    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@colyseus/sdk": "^0.18.10",
    "@tabletop/core": "workspace:*",
    "@tabletop/module-format": "workspace:*",
    "pixi.js": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
